function getCurrentCycle(today) {
    let monthNames = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"];
    let month = monthNames[today.getMonth()];
    let cycle = today.getDate() <= 15 ? "1ª Quinzena" : "2ª Quinzena";
    return `${cycle} ${month}`;
}

function getNextCycle(today) {
    let nextDate = new Date(today);
    nextDate.setDate(16);
    if (today.getDate() > 15) {
        nextDate.setMonth(today.getMonth() + 1);
        nextDate.setDate(1);
    }
    return getCurrentCycle(nextDate);
}

function scheduleNotifications_EMEB_TenenteAbilio() {
    let triggers = ScriptApp.getProjectTriggers();
    for (let trigger of triggers) {
        if (trigger.getHandlerFunction() === "checkFoldersAndSendEmail_EMEB_TenenteAbilio") {
            ScriptApp.deleteTrigger(trigger);
        }
    }
    
    ScriptApp.newTrigger("checkFoldersAndSendEmail_EMEB_TenenteAbilio")
        .timeBased()
        .everyDays(1)
        .atHour(8)
        .create();
    
    Logger.log("Notificações programadas para rodar diariamente às 8h.");
}
